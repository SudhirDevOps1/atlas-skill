{
  "name": "atlas-skill",
  "version": "1.0.0",
  "private": true,
  "description": "ATLAS - one master prompt plus one portable project-architect skill for coding agents.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node --check atlas-project-architect/scripts/version.mjs",
    "test": "node --test tests/version.test.mjs",
    "verify": "node --check atlas-project-architect/scripts/version.mjs && node --test tests/version.test.mjs && node atlas-project-architect/scripts/version.mjs verify",
    "version:show": "node atlas-project-architect/scripts/version.mjs show",
    "version:bump": "node atlas-project-architect/scripts/version.mjs bump",
    "version:set": "node atlas-project-architect/scripts/version.mjs set",
    "version:sync": "node atlas-project-architect/scripts/version.mjs sync",
    "version:verify": "node atlas-project-architect/scripts/version.mjs verify"
  }
}
